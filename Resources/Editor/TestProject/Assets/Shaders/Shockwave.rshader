shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_disabled;

uniform float speed : hint_range(0.1, 5.0) = 1.2;
uniform float frequency : hint_range(5.0, 50.0) = 20.0;
uniform float wave_width : hint_range(0.02, 0.4) = 0.12;
uniform float force : hint_range(0.001, 0.1) = 0.035;
uniform float aberration : hint_range(0.0, 0.05) = 0.006;
uniform vec3 highlight_color : source_color = vec3(1.2, 1.4, 1.8);
uniform float highlight_strength : hint_range(0.0, 1.0) = 0.25;

void fragment() {
    vec2 center = vec2(0.5);
    vec2 dir = UV - center;
    float dist = length(dir);
    
    float current_radius = mod(TIME * speed * 0.4, 0.7);
    
    float fade = 1.0 - smoothstep(0.3, 0.7, current_radius);
    
    float diff = dist - current_radius;
    float ring_mask = smoothstep(wave_width, 0.0, abs(diff));
    
    float wave = sin(diff * frequency) * ring_mask * fade;
    
    vec2 normal_dir = (dist > 0.0001) ? (dir / dist) : vec2(0.0);
    vec2 distortion = normal_dir * wave * force;
    
    vec2 distorted_uv = SCREEN_UV - distortion;
    
    vec2 r_offset = distortion * (1.0 + aberration * 50.0);
    vec2 b_offset = distortion * (1.0 - aberration * 50.0);
    
    float r = texture(SCREEN_TEXTURE, SCREEN_UV - r_offset).r;
    float g = texture(SCREEN_TEXTURE, distorted_uv).g;
    float b = texture(SCREEN_TEXTURE, SCREEN_UV - b_offset).b;
    vec3 scene_color = vec3(r, g, b);
    
    vec3 highlight = highlight_color * ring_mask * fade * highlight_strength;
    
    float circle_mask = smoothstep(0.5, 0.48, dist);
    
    vec3 final_color = mix(texture(SCREEN_TEXTURE, SCREEN_UV).rgb, scene_color + highlight, circle_mask);
    
    ALBEDO = final_color;
}